+/// Level 10's explicit FD6818B receive path. Keep modules off the raw FD6818 register recipe:
+/// the B chip has a different FSK programming sequence and exposes fixed 16-byte FIFO frames.
+unsafe extern "C" fn mod_fsk_rx_start() -> i32 {
+    #[cfg(feature = "fd6818b")]
+    {
+        let (app, syst) = unsafe { mod_ctx() };
+        app.radio.fd6818.enter_fsk_mode(syst);
+        return 0;
+    }
+    #[cfg(not(feature = "fd6818b"))]
+    -1
+}
+
+unsafe extern "C" fn mod_fsk_rx_ready() -> i32 {
+    #[cfg(feature = "fd6818b")]
+    {
+        let (app, syst) = unsafe { mod_ctx() };
+        return app.radio.fd6818.fsk_rx_ready(syst) as i32;
+    }
+    #[cfg(not(feature = "fd6818b"))]
+    0
+}
+
+unsafe extern "C" fn mod_fsk_rx_read(words: *mut u16) -> i32 {
+    if words.is_null() {
+        return -1;
+    }
+    #[cfg(feature = "fd6818b")]
+    {
+        let (app, syst) = unsafe { mod_ctx() };
+        if !app.radio.fd6818.fsk_rx_ready(syst) {
+            return -1;
+        }
+        let frame = app.radio.fd6818.fsk_receive(syst);
+        for (index, word) in frame.iter().enumerate() {
+            unsafe { words.add(index).write(*word) };
+        }
+        return 0;
+    }
+    #[cfg(not(feature = "fd6818b"))]
+    -1
+}
+
+unsafe extern "C" fn mod_fsk_rx_stop() {
+    #[cfg(feature = "fd6818b")]
+    {
+        let (app, syst) = unsafe { mod_ctx() };
+        app.radio.fd6818.exit_fsk_mode(syst);
+    }
+}
+
