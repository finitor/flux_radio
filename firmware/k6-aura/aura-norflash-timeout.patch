+    /// A bounded transfer for operations that must recover from a wedged peripheral.
+    pub fn try_transfer_byte(&mut self, byte: u8) -> Option<u8> {
+        let mut ready = false;
+        for _ in 0..TRANSFER_SPIN_LIMIT {
+            if self.regs.sr().read().txe().bit_is_set() { ready = true; break; }
+        }
+        if !ready { return None; }
+        unsafe { core::ptr::write_volatile(self.regs.dr().as_ptr() as *mut u8, byte); }
+        ready = false;
+        for _ in 0..TRANSFER_SPIN_LIMIT {
+            if self.regs.sr().read().rxne().bit_is_set() { ready = true; break; }
+        }
+        if !ready { return None; }
+        let rx = unsafe { core::ptr::read_volatile(self.regs.dr().as_ptr() as *const u8) };
+        ready = false;
+        for _ in 0..TRANSFER_SPIN_LIMIT {
+            if self.regs.sr().read().bsy().bit_is_clear() { ready = true; break; }
+        }
+        if ready { Some(rx) } else { None }
+    }
 }
 
